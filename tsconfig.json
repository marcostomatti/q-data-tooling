{
  // The shared Bun flavor (strict core, `module: Preserve`, bun types), and below it only what is
  // this project's own.
  "extends": "@open-tomato/typescript-config/bun",
  "compilerOptions": {
    // The web app runs in the browser beside the Bun server, so the DOM types join the latest ES.
    "lib": ["ESNext", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "target": "ESNext",
    "jsx": "react-jsx",
    "allowJs": true,
    // Imports name their `.ts` file, as Bun runs them.
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    // A service, not a package: it emits no declaration files, so the declaration checks guard
    // nothing here. `isolatedDeclarations` also cannot run beside `allowJs`, which the tests need
    // to import the ESLint rules in `eslint/rules/*.mjs`.
    "declaration": false,
    "isolatedDeclarations": false
  },
  "exclude": [
    "node_modules",
    // The built web bundle: `allowJs` would otherwise pull its minified chunks into the program.
    "src/web/dist"
  ]
}
