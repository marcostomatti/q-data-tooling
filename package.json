{
  "version": "0.1.0",
  "imports": {
    "#db": "./src/data/pg/index.ts"
  },
  "devDependencies": {
    "@open-tomato/eslint-config": "^0.1.1",
    "@open-tomato/typescript-config": "^0.1.1",
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-plugin-tailwind": "^0.1.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "tailwindcss": "^4.3.5",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@open-tomato/charts": "^0.1.2",
    "@open-tomato/components": "0.2.0",
    "@open-tomato/service": "^2.0.0",
    "@open-tomato/service-express": "^2.0.0",
    "@open-tomato/service-logger": "^2.0.0",
    "@open-tomato/service-mcp": "^2.1.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "jose": "^6.2.17",
    "postgres": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "swagger-ui-dist": "^5.34.1",
    "zod": "^4.6.7"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/data/migrate.ts",
    "db:status": "bun src/data/migration-status.ts",
    "db:seed": "bun src/data/seed.ts",
    "set-api-key": "bun src/auth/set-api-key.ts",
    "mcp": "bun src/mcp/server.ts",
    "serve": "bun run build:web && bun src/http/server.ts",
    "dev": "bun scripts/dev.ts",
    "backup": "bun src/backup/schedule.ts --once",
    "set-password": "bun src/auth/set-password.ts",
    "reset-credentials": "bun src/auth/reset-credentials.ts",
    "build:web": "bun scripts/build-web.ts",
    "docs:generate": "bun run docs:typedoc && bun run docs:openapi",
    "docs:typedoc": "typedoc",
    "docs:openapi": "bun scripts/export-openapi.ts",
    "typecheck": "tsc --noEmit -p .",
    "typecheck:pg": "tsc --noEmit -p tsconfig.pg.json",
    "test:integration": "bun test tests/integration tests/contract",
    "test:db": "bun scripts/test-db.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "privacy": "bun scripts/privacy-check.ts ."
  }
}