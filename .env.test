# Test settings. `bun test` sets NODE_ENV=test and then loads this file over `.env`, so a
# variable here replaces the one of the same name in `.env` for every test run, and the
# variables `.env` holds that this file does not name stay as they are.

# The Postgres server the integration tests use: the one `bun run db:up` starts. The tests never
# write to the database this URL names. Each test file creates a scratch database on this server,
# with these credentials, and drops it when the file is done. Nothing creates
# `template-service-test` itself, so code that reaches it by mistake fails loudly, and no test can
# write to the dev database `.env` names.
DATABASE_URL=postgres://template-service:template-service@localhost:5432/template-service-test
