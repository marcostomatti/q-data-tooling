# Copy to .env. Every line here is commented out, so a copy as it stands sets nothing and the
# defaults apply: SQLite at ./data/app.db, no login, and no notebook tools. Two things stop the
# service: it does not start until API_KEY or AUTH_MODE is set, or until SEC_USER_AGENT is set.

# --- Database: SQLite (the default) -------------------------------------------------------------
# The active dialect is the `#db` entry in package.json, SQLite by default. For SQLite,
# DATABASE_URL is `file:<path>` or `:memory:`, and unset means ./data/app.db.
# DATABASE_URL=file:./data/app.db

# --- Database: Postgres (optional) --------------------------------------------------------------
# With `#db` pointed at ./src/data/pg/index.ts, DATABASE_URL names Postgres instead, and
# `bun run db:up` starts the one in docker-compose.yaml. This URL is a placeholder for that local
# database, not a real credential. SQLite refuses it.
# DATABASE_URL=postgres://template-service:template-service@localhost:5432/template-service

# The host port the Docker database listens on is overridable, for when something else already
# holds 5432. If you set it, use the same port in DATABASE_URL above.
# DB_PORT=5432

# The backup on Postgres needs a pg_dump at least as new as the database (Postgres 16 in Docker).
# If yours is older, this runs the container's own; see docs/backup.md. Unset, `pg_dump`
# from your PATH is used. SQLite's backup needs no binary.
# PG_DUMP_BIN=scripts/pg_dump-docker.sh

# --- API key ------------------------------------------------------------------------------------
# The key clients send to this service is generated, not chosen, so no value is given here.
# Run `bun run setApiKey --burn-after-reading` to write one into your .env. With no key and no
# AUTH_MODE, the service does not start at all.
# API_KEY=

# --- SEC (required) ----------------------------------------------------------------------------
# The User-Agent sent with every request to SEC, as "<app name> <contact email>". SEC answers 403
# to a request without one, so the service does not start until it is set. The contact below is
# a placeholder: put your own app name and an address SEC can write to.
# SEC_USER_AGENT="q-data-tooling you@example.com"

# --- Signing in to the web app (docs/auth.md) ---------------------------------------------------
# Three modes, one at a time, chosen by AUTH_MODE:
#   unset (none): no login. The web app cannot sign in, and only API_KEY opens /api.
#   password:     one user with a password. Run `bun run set-password`, which writes AUTH_MODE
#                 and AUTH_PASSWORD_HASH here. Never put the password itself here.
#   oidc:         one account at a standard OpenID Connect provider, let in by subject or email.
# AUTH_MODE=password

# password mode:
# AUTH_PASSWORD_HASH=

# oidc mode. The values are placeholders. OIDC_CLIENT_SECRET may stay unset for a public client,
# and at least one of OIDC_ALLOWED_SUBJECT and OIDC_ALLOWED_EMAIL is required.
# OIDC_ISSUER=https://issuer.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3000/auth/oidc/callback
# OIDC_ALLOWED_SUBJECT=
# OIDC_ALLOWED_EMAIL=
# OIDC_SCOPES=openid email

# Either mode: set when the app is reached over HTTPS through a proxy, so the session cookie is
# marked Secure.
# AUTH_COOKIE_SECURE=true

# --- Open Notebook (optional) -------------------------------------------------------------------
# For the notebook_* MCP tools (docs/open-notebook.md). Unset, those tools are not registered.
# The key is the OPEN_NOTEBOOK_PASSWORD you gave the notebook; leave it unset for a notebook
# without a password.
# OPEN_NOTEBOOK_URL=http://localhost:5055
# OPEN_NOTEBOOK_API_KEY=
# docker-compose.notebook.yaml also passes OPEN_NOTEBOOK_API_KEY to the notebook as its password,
# and reads the key that encrypts the provider keys it stores (default change-me-template-service).
# OPEN_NOTEBOOK_ENCRYPTION_KEY=

# --- Ports, MCP and logs ------------------------------------------------------------------------
# The port `bun run serve` listens on (default 3000), and the port of the MCP server over HTTP
# (default 8080). A whole number from 1 to 65535.
# PORT=3000

# `true` stops the start when the port is taken. Unset, a taken port falls back to the next free
# one with a warning.
# PORT_STRICT=true

# The port of the health endpoint the MCP server starts over HTTP (default 3001), and its strict
# flag, which works as `PORT_STRICT` does. `PORT` does not move it.
# HEALTH_PORT=3001
# HEALTH_PORT_STRICT=true

# How `bun run mcp` talks: stdio when unset or `stdio`. Only the exact value `http` opts in to HTTP,
# and any other value exits 1 at start.
# MCP_TRANSPORT=http

# The lowest log level written: trace, debug, info (the default), warn, error, fatal or silent.
# LOG_LEVEL=info

# The shape of a log line: terminal (one readable line) or json. Unset picks terminal when the
# output is a terminal and json when it is not.
# LOG_FORMAT=json

# --- Tests and the privacy check ----------------------------------------------------------------
# A Postgres URL for the tests that need a server. Unset, those suites are skipped. Point it at a
# test database, never at one whose data you keep.
# TEST_PG_URL=

# The denylist file `bun run privacy` and scripts/public-export.ts read (docs/setup.md, "The
# denylist"). Keep the file outside git. Unset, the check runs without one and the export refuses.
# PRIVACY_DENYLIST=
